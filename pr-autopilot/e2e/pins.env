# The conductor and github plugin the moved-head e2e builds, when
# CONDUCTOR_SRC / PLUGINS_SRC don't name local checkouts: the releases this
# pack's requires floors name. Bump with them.
# conductor 0.97.0 (progress hooks, run.url) is not released yet: its branch
# until it is, then v0.97.0.
CONDUCTOR_REF=v0.97.0
# The github plugin: a release that declares its webhook listener, which
# the plugin jail needs before a delivery can reach it.
PLUGINS_REF=connectors/github/v2.14.0
