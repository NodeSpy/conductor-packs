#!/usr/bin/env bash
# A stand-in for the claude CLI (the cli runtime's claude-code recipe:
# `claude -p --output-format json < prompt`): the fixer's edit, made without
# a model. It commits a change in its worktree, then waits for the harness to
# move the PR branch under it (READY → GO), so conductor's end-of-step push
# finds the branch diverged. A second run (refix) sees MOVED_HEAD in its task.
set -euo pipefail
prompt="$(cat)"
printf '%s' "$prompt" > .e2e-prompt-$$
# Its report: the inline review comment it was asked about (the event's
# comment_id, when comment_kind is review), as addressed by its change.
addressed=""
if grep -q '"comment_kind": *"review"' .e2e-prompt-$$; then
  addressed="$(grep -o '"comment_id": *[0-9]*' .e2e-prompt-$$ | head -1 | grep -o '[0-9]*$')"
fi
report() { # report <session> <summary>: the cli result, the structured report as JSON text
  python3 -c 'import json,sys; ids=[int(sys.argv[3])] if sys.argv[3] else []; print(json.dumps({"session_id":sys.argv[1],"result":json.dumps({"addressed_comments":ids,"summary":sys.argv[2]})}))' "$1" "$2" "$addressed"
}
git config user.email fixer@example.invalid
git config user.name fixer
if grep -q "PROGRESS-E2E" .e2e-prompt-$$; then
  # The progress scenario: the fixer says what it is doing as it goes
  # (step.progress), more than the pack's pacing (30s, checked every 5s)
  # apart, so each note shows on the PR's status in turn.
  say() { conductor call step.progress --text "$1" >> .e2e-progress.log 2>&1 || echo "step.progress failed" >> .e2e-progress.log; }
  say "reading the comment"; sleep 45
  sed -i 's/return 1$/return 10/' main.go
  say "editing main.go"; sleep 45
  git add main.go && git commit -qm "fix main.go"
  say "running the tests"; sleep 45
  rm -f .e2e-prompt-$$
  report e2e-progress done
  exit 0
fi
if grep -q "second attempt" .e2e-prompt-$$; then
  # The second attempt, on the new head: redo the change by hand.
  sed -i 's/return 99/return 10/; s/return 1$/return 10/' main.go
  git add main.go && git commit -qm "fix a() on the new head"
  rm -f .e2e-prompt-$$
  report e2e-refix "done again"
  exit 0
fi
if grep -q "make b() return 20" .e2e-prompt-$$; then
  sed -i 's/return 2$/return 20/' main.go # another fixer's change, elsewhere
else
  sed -i 's/return 1$/return 10/' main.go
fi
if grep -q "and add the big table" .e2e-prompt-$$ 2>/dev/null; then
  # A change past the diff output's 64 KiB cap.
  for i in $(seq 1 3000); do echo "row $i: the quick brown fox jumps over the lazy dog"; done > table.txt
  git add table.txt
fi
git add main.go && git commit -qm "fix main.go"
rm -f .e2e-prompt-$$
touch .e2e-ready
for _ in $(seq 1 300); do [ -e .e2e-go ] && break; sleep 0.1; done
rm -f .e2e-ready .e2e-go
report e2e-fix done
